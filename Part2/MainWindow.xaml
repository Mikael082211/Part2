<Window x:Class="Part2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Assistant"
        Height="850"
        Width="520"
        Background="#081416"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">

    <!-- MAIN GRID -->
    <Grid x:Name="MainGrid">

        <!-- BACKGROUND -->
        <Grid.Background>
            <RadialGradientBrush GradientOrigin="0.5,0.3"
                                 Center="0.5,0.5"
                                 RadiusX="1"
                                 RadiusY="1">

                <GradientStop Color="#1ED7C6" Offset="0"/>
                <GradientStop Color="#0D5C63" Offset="0.45"/>
                <GradientStop Color="#082B30" Offset="0.75"/>
                <GradientStop Color="#041517" Offset="1"/>

            </RadialGradientBrush>
        </Grid.Background>

        <!-- ROWS -->
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="95"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <Border x:Name="HeaderBorder"
                Grid.Row="0"
                Background="#163F44"
                CornerRadius="0,0,25,25">

            <Grid Margin="15">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>

                <!-- LOGO -->
                <Border Width="65"
                        Height="65"
                        Background="#6FFFE9"
                        CornerRadius="32"
                        VerticalAlignment="Center">

                    <Image Source="/Resources/logo.png"
                           Stretch="Fill"/>
                </Border>

                <!-- TITLE -->
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">

                    <TextBlock Text="Cybersecurity Assistant"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock x:Name="txtStatus"
                               Text="Enter your name to begin"
                               FontSize="14"
                               Foreground="#B8FFF5"/>
                </StackPanel>

                <!-- THEME BUTTON -->
                <Button x:Name="btnTheme"
                        Grid.Column="2"
                        Width="40"
                        Height="40"
                        Content="☀"
                        Click="btnTheme_Click"
                        FontSize="18"
                        Background="#6FFFE9"
                        Foreground="Black"
                        BorderThickness="0"
                        Cursor="Hand"
                        VerticalAlignment="Center">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="20">

                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>

                            </Border>
                        </ControlTemplate>
                    </Button.Template>

                </Button>

            </Grid>
        </Border>

        <!-- ================= CHAT AREA ================= -->
        <ScrollViewer x:Name="ChatScrollViewer"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Margin="15">

            <StackPanel x:Name="ChatPanel"/>
        </ScrollViewer>

        <!-- ================= INPUT AREA ================= -->
        <Border x:Name="InputBorder"
                Grid.Row="2"
                Background="#163F44"
                CornerRadius="25"
                Margin="12">

            <Grid Margin="12">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <!-- INPUT BOX -->
                <Border Background="#B8FFF5"
                        CornerRadius="22"
                        Margin="0,0,10,0">

                    <TextBox x:Name="txtUserInput"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="18"
                             Padding="18,12"
                             VerticalContentAlignment="Center"
                             Foreground="#0B2326"/>
                </Border>

                <!-- SEND BUTTON -->
                <Button x:Name="btnSend"
                        Grid.Column="1"
                        Content="Send"
                        Click="btnSend_Click"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="White"
                        Cursor="Hand"
                        BorderThickness="0">

                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,1">

                            <GradientStop Color="#6FFFE9"
                                          Offset="0"/>

                            <GradientStop Color="#3ABFAE"
                                          Offset="1"/>

                        </LinearGradientBrush>
                    </Button.Background>

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="22">

                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>

                            </Border>
                        </ControlTemplate>
                    </Button.Template>

                </Button>

            </Grid>
        </Border>

    </Grid>
</Window>